# Netlify header kuralları.
#
# Neden burada, netlify.toml'da değil: bu sitede toml redirect'leri uygulanmıyor
# (bkz. _redirects başındaki not), o yüzden aynı riski header'larda da almıyoruz —
# _redirects nasıl çalışan yerse, _headers de öyle.
#
# JSON veri dosyaları taranabilir ama dizine eklenmez. robots.txt'teki Disallow
# taramayı da kestiği için Googlebot bunları render sırasında çekemiyordu ve
# şehir sayaçları / arşiv listeleri arama motoru için hiç dolmuyordu.

/articles.json
  X-Robots-Tag: noindex
  Access-Control-Allow-Origin: *

/*.json
  X-Robots-Tag: noindex

